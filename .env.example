# ============================================================
# Multilingual GenAI Voice Assistant - Configuration
# ============================================================
# 
# This file contains all environment variables required to run
# the application. Copy this to .env and fill in your values.
#
# IMPORTANT: Never commit .env to version control!
# 

# ============================================================
# Application Settings
# ============================================================

APP_NAME=Multilingual GenAI Voice Assistant
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ============================================================
# Gemini API
# ============================================================
# 
# Required: Get your API key from https://aistudio.google.com/
# 
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ============================================================
# ChromaDB Configuration
# ============================================================
#
# The RAG system uses ChromaDB for knowledge retrieval.
# 
# CHROMA_PATH: Local directory where ChromaDB persists data
#   Default: rag/data/chroma (relative to project root)
# 
CHROMA_PATH=rag/data/chroma
CHROMA_COLLECTION=telecom_knowledge

# ============================================================
# MongoDB Configuration
# ============================================================
#
# Used for storing customer data, call logs, and telecom tool data.
# 
# MONGODB_URI: Connection string for MongoDB
#   Format: mongodb://username:password@host:port/database
#   Example: mongodb://localhost:27017/genai_assistant
# 
# MONGODB_DATABASE: Database name
#   Default: genai_assistant
# 
MONGODB_URI=mongodb://localhost:27017/genai_assistant
MONGODB_DATABASE=genai_assistant

# ============================================================
# Redis Configuration (Optional)
# ============================================================
#
# Used for session caching and rate limiting (future feature)
# 
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Frontend Configuration
# ============================================================
#
# FRONTEND_URL: URL where the React frontend is served
#   Used for CORS configuration
#
FRONTEND_URL=http://localhost:5173

# ============================================================
# Logging Configuration
# ============================================================
#
# LOG_LEVEL: Controls logging verbosity
#   Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
#
LOG_LEVEL=INFO

# ============================================================
# Environment
# ============================================================
#
# ENVIRONMENT: Deployment environment
#   Options: development, staging, production
#
ENVIRONMENT=development

# ============================================================
# Supported Languages
# ============================================================
# (Read-only: configured in code)
# 
# - English (en)
# - Tamil (ta)
# - Hindi (hi)
# - Telugu (te)
# - Kannada (kn)
# - Malayalam (ml)
# - Bengali (bn)
# - Marathi (mr)
# - Gujarati (gu)
# - Punjabi (pa)
# 

# ============================================================
# Notes for Development
# ============================================================
# 
# 1. MongoDB Setup:
#    - Install MongoDB locally or use Docker
#    - docker run -d -p 27017:27017 --name mongodb mongo:latest
#    - Update MONGODB_URI if using non-default configuration
# 
# 2. Gemini API Key:
#    - Visit https://aistudio.google.com/
#    - Create new API key
#    - Paste in GEMINI_API_KEY
# 
# 3. Frontend URL:
#    - For local development: http://localhost:5173 (Vite)
#    - For npm dev: http://localhost:3000
# 
# 4. Logging:
#    - Use DEBUG for detailed development logging
#    - Use INFO for production
# 
